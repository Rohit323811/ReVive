# ─────────────────────────────────────────────────────────────────────────────
# ReVive — environment configuration
# Copy this file to .env for local dev:  cp .env.example .env
# On Vercel, add these same keys under Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Grok (xAI) API key — SERVER-SIDE ONLY (used by api/analyze.ts).
#    Never prefixed with VITE_, so it can never reach the browser.
#    Get one: https://console.x.ai → API Keys
XAI_API_KEY=xai-your-api-key-here

# 2. Supabase — authentication (the anon key is public by design; data is
#    protected by row-level security in supabase/schema.sql).
#    Get yours: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Both keys are OPTIONAL for local dev: without them the app runs in demo mode
# (curated offline object catalog, no accounts) and remains fully presentable.
